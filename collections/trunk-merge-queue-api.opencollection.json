            "name": "Get merge queue metrics (Prometheus text exposition format)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.trunk.io/v1/getMergeQueueMetrics",
            "params": [
              {
                "name": "repo",
                "value": "",
