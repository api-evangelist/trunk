{
  "opencollection": "1.0.0",
  "info": {
    "name": "Trunk Flaky Tests Merge Queue API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-token",
      "value": "{{x-api-token}}",
      "placement": "header"
    }
  },
  "items": [
